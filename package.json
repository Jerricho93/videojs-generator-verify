{
  "name": "videojs-generator-verify",
  "version": "4.1.3",
  "description": "A tool to verify that a generator-videojs-plugin project is ready for publish.",
  "main": "src/index.js",
  "bin": {
    "vjsverify": "src/cli.js",
    "videojs-generator-verify": "src/cli.js"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/videojs-generator-verify"
  },
  "author": "Brandon Casey <brandonocasey@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@brandonocasey/spawn-promise": "~0.2.0",
    "colorette": "^2.0.16",
    "es-check": "^7.1.1",
    "exit-hook": "^2.2.1",
    "shelljs": "^0.8.4"
  },
  "scripts": {
    "lint": "vjsstandard",
    "pretest": "npm run lint",
    "test": "npm run test:unit",
    "test:unit": "ava test/*.test.js -s",
    "preversion": "npm test",
    "version": "is-prerelease || npm run update-changelog && git add CHANGELOG.md",
    "update-changelog": "conventional-changelog -p videojs -i CHANGELOG.md -s",
    "prepublishOnly": "./src/cli.js --skip-syntax --verbose"
  },
  "lint-staged": {
    "*.js": "vjsstandard --fix",
    "README.md": "doctoc --notitle"
  },
  "files": [
    "src"
  ],
  "vjsstandard": {
    "ignore": [
      "test/fixture"
    ]
  },
  "devDependencies": {
    "@videojs/generator-helpers": "^3.2.0",
    "ava": "^3.15.0",
    "videojs-standard": "^9.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "semver": "^7.6.0",
    "underscore": "^1.13.8",
    "lodash": "^4.18.1",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "minimatch": "^10.0.0",
    "picomatch": "^4.0.4",
    "yaml": "^2.9.0",
    "tmp": "^0.2.5",
    "ajv": "^8.20.0",
    "js-yaml": "^4.1.1",
    "micromatch": "^4.0.8",
    "trim": "^1.0.1",
    "word-wrap": "^1.2.5",
    "minimist": "^1.2.8",
    "got": "^11.8.6"
  },
  "bugs": {
    "url": "https://github.com/videojs/videojs-generator-verify/issues"
  },
  "homepage": "https://github.com/videojs/videojs-generator-verify"
}
